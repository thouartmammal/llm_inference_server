{
  "uid": "llm-gateway",
  "title": "LLM Gateway and Scheduler",
  "tags": ["llm", "gateway", "scheduler", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Time to First Token (p95)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(llm_gateway_time_to_first_token_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Inter-token Latency (p95)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(llm_gateway_inter_token_latency_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scheduler Queue Depth",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_scheduler_queue_depth"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Scheduler Batch Size (avg)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llm_scheduler_batch_size_sum[5m])) / sum(rate(llm_scheduler_batch_size_count[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker RPC Latency (p95)",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(llm_scheduler_worker_rpc_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests and Cancellations",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llm_gateway_requests_total[5m])"
        },
        {
          "refId": "B",
          "expr": "rate(llm_gateway_request_cancellations_total[5m])"
        }
      ]
    }
  ]
}